{
  "name": "@doctor-directory/directory-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 4000 --inspector-port 9231 --persist-to ../../.wrangler/demo",
    "deploy": "wrangler deploy",
    "seed:local": "wrangler r2 object put doctor-directory-demo/healthcare_data.json --file ../../healthcare_data.json --local --persist-to ../../.wrangler/demo",
    "seed:remote": "wrangler r2 object put doctor-directory-demo/healthcare_data.json --file ../../healthcare_data.json --remote"
  },
  "dependencies": {
    "@doctor-directory/shared": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "wrangler": "catalog:"
  }
}
