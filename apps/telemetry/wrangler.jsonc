{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telemetry",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // No public URL: the services and the console reach it only through service bindings.
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "EventHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventHub"] }],
  "observability": { "enabled": true }
}
